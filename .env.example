# Copy to .env before changing anything. .env is gitignored.
#
# Uptime Kuma reads TZ (dashboard timestamps) and the host port below.
# TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID are the values you paste into
# Settings -> Notifications -> Telegram. Compose does not pass them into
# the container. See README.md for how to create the bot and chat id.

# Host port for the dashboard. The process inside the container listens on 3001.
UPTIME_KUMA_PORT=3001

# IANA timezone for timestamps and maintenance windows.
TZ=Europe/Lisbon

# Token from @BotFather. Shape: 123456789:AA...
TELEGRAM_BOT_TOKEN=replace-with-token-from-botfather

# Numeric chat id. Group and supergroup ids are negative.
TELEGRAM_CHAT_ID=replace-with-chat-id
