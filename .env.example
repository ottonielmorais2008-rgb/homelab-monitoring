# Copy to .env before changing anything. .env is gitignored.
#
# Uptime Kuma reads TZ. TELEGRAM_* values are pasted into the dashboard
# notification form; Compose does not pass them into the container.
# See README.md for how to create the bot and chat id.

# Host port for the Nginx front door (HTTP).
NGINX_HTTP_PORT=8080

# IANA timezone for Uptime Kuma timestamps and maintenance windows.
TZ=Europe/Lisbon

# Token from @BotFather. Shape: 123456789:AA...
TELEGRAM_BOT_TOKEN=replace-with-token-from-botfather

# Numeric chat id. Group and supergroup ids are negative.
TELEGRAM_CHAT_ID=replace-with-chat-id
